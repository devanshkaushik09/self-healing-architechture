# ── App (MiniCart) ────────────────────────────────────
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/minicart

# ── Sentry (error tracking) ───────────────────────────
SENTRY_DSN=

# ── Anthropic / Claude API (AI agent) ─────────────────
ANTHROPIC_API_KEY=

# ── GitHub (agent needs this to branch/commit/PR/merge) ──
GITHUB_TOKEN=
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=self-healing-architecture

# ── Deployment platform (Render/Railway deploy webhooks) ─
DEPLOY_WEBHOOK_URL=
STAGING_APP_URL=
PROD_APP_URL=

# ── Watchdog ───────────────────────────────────────────
HEALTH_CHECK_INTERVAL_SECONDS=10
HEALTH_CHECK_FAILURE_THRESHOLD=3

# ── Notifications ──────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ── Agent safety limits ────────────────────────────────
MAX_AUTO_FIXES_PER_HOUR=3
MAX_DIFF_LINES=40
ALLOWED_FIX_PATHS=src/routes,src/services
